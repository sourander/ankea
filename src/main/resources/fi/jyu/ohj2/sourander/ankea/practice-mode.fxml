<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="400.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fi.jyu.ohj2.sourander.ankea.controller.PracticeModeController">
    <children>
        <HBox maxHeight="1.7976931348623157E308" minHeight="0.0" VBox.vgrow="ALWAYS">
            <children>
                <Label minWidth="100.0" text="Front" />
            <TextArea fx:id="frontTextArea" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
        <HBox maxHeight="1.7976931348623157E308" minHeight="0.0" VBox.vgrow="ALWAYS">
            <children>
                <Label minWidth="100.0" text="Back" />
                <TextArea fx:id="backTextArea" text="Click me to reveal the answer" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
        <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="NEVER">
            <children>
                <Button fx:id="prevButton" minWidth="80.0" text="Previous" />
                <Region HBox.hgrow="ALWAYS" /> 
                <Button fx:id="exitButton" text="Exit" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="nextButton" minWidth="80.0" text="Next" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
